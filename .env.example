# Mot de passe unique de l'espace d'administration (/admin).
ADMIN_PASSWORD=

# Clé de signature des sessions admin. À générer avec :
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Fourni automatiquement par Vercel après la création d'un store Blob.
# En local : `vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# Statistiques de fréquentation affichées dans /admin, lues via l'API Web
# Analytics de Vercel. Le jeton est un secret de compte : jamais de préfixe
# NEXT_PUBLIC_, il ne doit pas partir dans le navigateur.
# Jeton : https://vercel.com/account/settings/tokens (portée limitée au projet).
VERCEL_TOKEN=
# Identifiant du projet, format `prj_...` : Vercel → projet → Settings → General.
VERCEL_PROJECT_ID=

# Clé d'API Resend (https://resend.com/api-keys), format `re_...`.
RESEND_API_KEY=

# Adresse qui reçoit tous les messages du formulaire de contact.
CONTACT_EMAIL_TO=

# Expéditeur des messages, format `Nom <adresse@domaine.fr>`. Le domaine doit
# être vérifié dans Resend (https://resend.com/domains).
# Si vide : `Atelier Petita <onboarding@resend.dev>`, le domaine partagé de
# Resend — il fonctionne sans vérification mais ne distribue qu'à l'adresse du
# titulaire du compte.
CONTACT_EMAIL_FROM=
