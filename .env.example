# Ce fichier contient des secrets une fois rempli : `chmod 600 .env` après
# l'avoir créé, pour qu'aucun autre compte du poste ne puisse le lire.

# Mot de passe unique de l'espace d'administration (/admin).
# Laisser vide dès qu'ADMIN_PASSWORD_HASH est renseigné.
ADMIN_PASSWORD=

# Empreinte lente du mot de passe, à préférer à la ligne ci-dessus : une fuite
# des variables d'environnement ne livre alors plus le mot de passe lui-même.
# À générer avec :
#   npm run empreinte-mot-de-passe
# Renseignée, elle fait foi et ADMIN_PASSWORD n'est plus lu.
ADMIN_PASSWORD_HASH=

# Clé de signature des sessions admin. À générer avec :
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Stockage des photos et du catalogue : bucket Cloudflare R2.
# Point d'accès S3 du compte, juridiction UE de préférence :
#   https://<id-du-compte>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Jeton d'API R2 « Lecture et écriture d'objets », limité à ce bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domaine personnalisé relié au bucket, qui sert les photos au public.
# Exemple : https://photos.atelierpetita.fr
R2_PUBLIC_URL=

# Ancien store Vercel Blob : ne sert plus qu'au script de migration
# (`npm run migrer-vers-r2`). À retirer une fois la migration faite.
BLOB_READ_WRITE_TOKEN=

# Secret du balayage quotidien des photos orphelines (voir vercel.json).
# Vercel signe l'appel de /api/menage avec `Authorization: Bearer <valeur>` dès
# que cette variable existe côté projet ; sans elle, la route refuse tout.
# À générer avec :
#   openssl rand -base64 32
CRON_SECRET=

# Statistiques de fréquentation affichées dans /admin, lues via l'API Web
# Analytics de Vercel. Le jeton est un secret de compte : jamais de préfixe
# NEXT_PUBLIC_, il ne doit pas partir dans le navigateur.
# Jeton : https://vercel.com/account/settings/tokens (portée limitée au projet).
VERCEL_TOKEN=
# Identifiant du projet, format `prj_...` : Vercel → projet → Settings → General.
VERCEL_PROJECT_ID=

# Clé d'API Resend (https://resend.com/api-keys), format `re_...`.
RESEND_API_KEY=

# Adresse qui reçoit tous les messages du formulaire de contact.
CONTACT_EMAIL_TO=

# Expéditeur des messages, format `Nom <adresse@domaine.fr>`. Le domaine doit
# être vérifié dans Resend (https://resend.com/domains).
# Si vide : `Atelier Petita <onboarding@resend.dev>`, le domaine partagé de
# Resend — il fonctionne sans vérification mais ne distribue qu'à l'adresse du
# titulaire du compte.
CONTACT_EMAIL_FROM=
